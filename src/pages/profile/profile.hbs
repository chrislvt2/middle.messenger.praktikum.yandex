<div class="profile-page">
    {{> sidebar-button}}
    <div class="profile-page__content">
        <div class="profile-page__profile">
            {{> avatar }}
            <div class="profile-page__profile-title">Иван</div>
            {{#if passwordEditMode}}
                <form class="profile-page__profile-section">
                    {{> form-field id="oldPasswordField" label="Старый пароль" name="oldPassword" type="password"}}
                    {{> form-field id="newPasswordField" label="Новый пароль" name="newPassword" type="password"}}
                    {{> form-field id="repeatedNewPasswordField" label="Повторите новый пароль" name="repeatedNewPassword" type="password"}}
                </form>
                <div class="profile-page__profile-section">
                    {{> button id="savePasswordButton" label="Сохранить"}}
                </div>
            {{else}}
                <form class="profile-page__profile-section"
                      id="profileForm"
                >
                    {{> form-field label="Почта" id="emailField" name="email" value="pochta@yandex.ru" type="email" }}
                    {{> form-field label="Логин" id="loginField" name="login" value="ivanivanov" type="text"}}
                    {{> form-field label="Имя" id="first_nameField" name="first_name" value="Иван" type="text"}}
                    {{> form-field label="Фамилия" id="second_nameField" name="second_name" value="Иванов" type="text"}}
                    {{> form-field label="Имя в чате" id="display_nameField" name="display_name" value="Иван" type="text"}}
                    {{> form-field label="Телефон" id="phoneField" name="phone" value="+7 (909) 967 30 30" type="tel"}}
                </form>
                {{#if profileEditMode}}
                    <div class="profile-page__profile-section">
                        {{> button id="saveProfileButton" label="Сохранить"}}
                    </div>
                {{else}}
                    <div class="profile-page__profile-section">
                        {{> button id="editProfileButton" label="Изменить данные"}}
                        {{> button id="editPasswordButton" label="Изменить пароль"}}
                        {{> button id="exitProfileButton" label="Выйти"}}
                    </div>
                {{/if}}
            {{/if}}
        </div>
    </div>
</div>