<div class="chat-page">
    <div class="chat-page__list">
        <div class="chat-page__settings">
            {{> button class="chat-page__profile-button" id="openProfile" label="Профиль"}}
            {{> search-field class="chat-page__search-input" }}
        </div>
        <div class="chat-page__chats">
            <ul>
                {{#each previewChats}}
                    <li>
                        {{> chat-preview this}}
                    </li>
                {{/each}}
            </ul>
        </div>
    </div>
    <div class="chat-page__messages">Выберите чат, чтобы отправить сообщение</div>
</div>