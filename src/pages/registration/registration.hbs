<div class="registration-page">
    <form class="form">
        <div class="form__title">Регистрация</div>

        <div class="form__inputs">
            {{> form-field label="Почта" id="emailRegField" name="email" type="email"}}
            {{> form-field label="Логин" id="loginRegField" name="login" type="text"}}
            {{> form-field label="Имя" id="first_nameRegField" name="first_name" type="text"}}
            {{> form-field label="Фамилия" id="second_nameRegField" name="second_name" type="text"}}
            {{> form-field label="Телефон" id="phoneRegField" name="phone" type="tel"}}
            {{> form-field label="Пароль" id="passwordRegField" name="password" type="password"}}
            {{> form-field label="Пароль (ещё раз)" id="password_confirmRegField" name="password_confirm" type="password_confirm"}}
        </div>

        <div class="form__buttons">
            {{> button id="registerButton" label="Зарегестрироваться"}}
            {{> button id="returnToLogin" label="Войти"}}
        </div>
    </form>
</div>